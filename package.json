{
  "name": "goldfelty-portfolio-manager",
  "version": "1.1.0",
  "description": "Goldfelty Portfolio Manager \u2014 a multi-wallet smart-account portfolio manager for macOS, Windows and Linux.",
  "author": "Goldfelty",
  "homepage": "https://goldfelty.com",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/*.test.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --arm64 --publish never",
    "smoke": "node scripts/smoke.cjs",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@walletconnect/sign-client": "^2.25.0",
    "@walletconnect/utils": "^2.25.0",
    "electron-updater": "^6.3.9",
    "ethers": "^6.13.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}

{
  "name": "goldfelty-portfolio-manager",
  "version": "1.2.2",
  "description": "Goldfelty Portfolio Manager: one portfolio for the wallets you already use, on macOS, Windows and Linux.",
  "author": "Goldfelty",
  "homepage": "https://goldfelty.com",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --test-timeout=60000 tests/*.test.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --arm64 --publish never",
    "e2e": "node scripts/e2e.cjs",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@walletconnect/sign-client": "^2.25.0",
    "@walletconnect/utils": "^2.25.0",
    "bitcoinjs-lib": "^6.1.9",
    "ethers": "^6.13.4",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "ecpair": "^2.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.7"
  }
}

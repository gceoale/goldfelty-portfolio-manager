{
  "name": "goldfelty-social",
  "version": "0.1.0",
  "private": true,
  "description": "Runs Goldfelty's own X, Reddit and YouTube accounts on autopilot: writes posts and funny Shorts, checks them, and publishes at a steady pace.",
  "type": "module",
  "bin": {
    "goldfelty-social": "bin/goldfelty-social.js"
  },
  "scripts": {
    "start": "node bin/goldfelty-social.js run",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "kokoro-js": "1.2.1",
    "playwright": "1.63.0",
    "@huggingface/transformers": "3.8.1"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}

{
  "name": "goldfelty-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Account registration for goldfelty.com, on Cloudflare Workers",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create goldfelty-accounts",
    "db:migrate": "wrangler d1 execute goldfelty-accounts --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute goldfelty-accounts --local --file=./schema.sql",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.1"
  },
  "devDependencies": {
    "ethers": "^6.13.4",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
